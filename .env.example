# Server-only env for Vercel / `vercel dev` (never commit real values)

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Admin session (single admin)
# Generate AUTH_SECRET: openssl rand -hex 32
# Reset password (quotes the hash so $ is not mangled):
#   node scripts/reset-admin-password.mjs "YourNewPassword"
AUTH_SECRET=
ADMIN_EMAIL=info@quayvox.com
# IMPORTANT: wrap bcrypt hashes in single quotes — they contain $ characters
ADMIN_PASSWORD_HASH='$2a$10$replace_me'

# Resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Quayvox <noreply@quayvox.com>
CONTACT_TO_EMAIL=info@quayvox.com
PUBLIC_APP_URL=https://www.quayvox.com
