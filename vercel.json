{
  "version": 2,
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "installCommand": "npm install && npm run build:api && cd app && npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler?path=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
